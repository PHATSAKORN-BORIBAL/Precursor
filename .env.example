# Copy to .env and edit. .env is ignored by git. Never commit real values.
# Every variable is optional; defaults come from config/default.yaml.

# Where the dashboard/API listens. Keep 127.0.0.1 unless you know why not.
PRECURSOR_HOST=127.0.0.1
PRECURSOR_PORT=8000

# simulate = built-in simulated pump rig (no hardware needed)
# ingest   = accept real readings via POST /api/ingest
PRECURSOR_MODE=simulate

# Simulation only: samples per wall-clock second and random seed.
PRECURSOR_SIM_SPEED=20
PRECURSOR_SIM_SEED=42
PRECURSOR_SIM_AUTO_FAULTS=true

# SQLite file holding the sealed incident chain.
PRECURSOR_DB_PATH=data/precursor.db

# Shared secret required in the X-API-Key header for POST endpoints.
# Leave empty only when listening on 127.0.0.1. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PRECURSOR_API_KEY=

# Optional: override where config/ and app/ are looked up.
# PRECURSOR_CONFIG_DIR=config
# PRECURSOR_APP_DIR=app
